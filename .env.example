# Pradapicks environment variables — defaults work without any paid API keys.
DATABASE_URL=sqlite:///./pradapicks.db
API_AUTH_TOKEN=change_me_to_a_long_random_string
RUN_SCHEDULER=true
AUTO_BOOTSTRAP_DAYS=30
TZ=America/New_York
LOG_LEVEL=INFO
# Optional: only set if you have a paid The Odds API key. Free providers
# (PrizePicks, DraftKings) are used automatically without one.
# ODDS_API_KEY=
