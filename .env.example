# All defaults work with zero configuration.
DB_PATH=./data/pradapicks.db
MODELS_DIR=./models
DOCS_DIR=./docs
LOG_LEVEL=INFO
TZ=America/New_York
HTTP_TIMEOUT=20
BACKFILL_DAYS=45
# Bankroll used for Kelly stake recommendations in the dashboard.
BANKROLL=1000
KELLY_FRACTION=0.25
# Live odds feed — get a FREE key at https://the-odds-api.com (500 req/mo).
# Unlocks reliable live props across every sport incl. the FIFA World Cup.
# Leave blank to fall back to the free direct-scraper sources.
ODDS_API_KEY=
ODDS_API_MAX_EVENTS=8

# On-the-spot alerts (both optional). Fire when a pick grades >= NOTIFY_MIN_GRADE.
# Phone push (free, no account): pick any secret topic, install the ntfy app,
# subscribe to it. Email: use a Google App Password, not your login password.
NOTIFY_MIN_GRADE=A-
NOTIFY_NTFY_TOPIC=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_APP_PASSWORD=
NOTIFY_EMAIL_TO=
