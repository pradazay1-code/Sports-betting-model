# ---------------------------------------------------------------------------
# The Desk — API keys. Copy to .env and fill in. .env is gitignored.
# ---------------------------------------------------------------------------

# The Odds API — primary odds feed (moneyline, spreads, totals, some props).
# Free tier: 500 requests/month. Sign up: https://the-odds-api.com/
# Required for /slate, /analyze, /props.
ODDS_API_KEY=

# --- Everything below is OPTIONAL. The agent works without them. ------------

# API-Sports / api-sports.io — soccer, tennis, extra league coverage.
# Free tier: 100 req/day. https://dashboard.api-football.com/
API_SPORTS_KEY=

# SportsDataIO — richer injury feeds and player props if you want to pay.
# https://sportsdata.io/
SPORTSDATAIO_KEY=

# OpenWeather — only if you want an Open-Meteo fallback. Open-Meteo needs no
# key and is the default weather source. https://openweathermap.org/api
OPENWEATHER_KEY=

# --- Behavior knobs (defaults shown; all optional) --------------------------

# Cache TTL overrides, in seconds.
CACHE_TTL_ODDS=300
CACHE_TTL_STATS=21600
CACHE_TTL_NEWS=900
CACHE_TTL_WEATHER=3600

# Bankroll in units for staking math. 1 unit = 1% of bankroll by convention.
BANKROLL_UNITS=100

# Kelly divisor. 4 = quarter Kelly (the default and the house standard).
KELLY_DIVISOR=4

# Hard ceiling on any single recommendation, in units.
MAX_STAKE_UNITS=2.0

# Minimum EV% (as a decimal: 0.02 = 2%) to call something a bet.
MIN_EV=0.02
