# Required. Get one at https://platform.claude.com → API keys.
# In Vercel: Settings → Environment Variables → add ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=sk-ant-...

# Optional but strongly recommended for college football.
# Free key: https://collegefootballdata.com/key
# Without it the agent cannot RETRIEVE SP+, and since it refuses to price a
# college side without a ratings spine, CFB sides fall back to web research.
# Covers FCS as well as FBS, which mainstream feeds do not.
CFBD_API_KEY=

# Optional. Requests per hour per serverless instance; 0 disables.
# In-memory, so this resets on cold start — see the README.
RATE_LIMIT_PER_HOUR=30
