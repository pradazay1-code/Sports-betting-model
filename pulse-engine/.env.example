# ---- Kalshi API (optional — market data works without keys, but rate limits are lower) ----
# Create an API key at https://kalshi.com/account/profile (API Keys section).
# KALSHI_API_KEY_ID is the key's UUID; KALSHI_PRIVATE_KEY_PATH points at the
# RSA private key PEM file you downloaded when creating the key.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# ---- News (optional) ----
# Free key: https://cryptopanic.com/developers/api/
CRYPTOPANIC_KEY=

# ---- Overrides (all have sensible defaults in config.py) ----
# EXCHANGE_ID=binanceus          # binanceus | binance | coinbase | kraken
# DASHBOARD_PORT=8777
# MIN_EDGE_BUFFER=0.03
# BACKFILL_DAYS=90
# LOG_LEVEL=INFO

# ---- Phase 9 (trade execution) is OFF by default and NOT built unless requested ----
I_UNDERSTAND_THE_RISK=false
